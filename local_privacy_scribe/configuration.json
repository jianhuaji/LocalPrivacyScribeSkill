      },
      "error_message": {
        "type": "string",
        "title": "错误信息",
        "readOnly": true
      }
    }
  },
  "device_support": {
    "npu": {
      "supported": true,
      "description": "Intel 神经网络处理器（NPU），推荐用于边缘设备",
      "driver_required": "OpenVINO NPU Driver",
      "setup_guide": "https://docs.openvino.ai/latest/openvino_docs_install_guides_overview.html"
    },
    "gpu": {
      "supported": true,
      "description": "集成或独立显卡（Intel GPU / NVIDIA GPU）",
      "driver_required": "OpenVINO GPU Plugin",
      "setup_guide": "https://docs.openvino.ai/latest/openvino_docs_install_guides_overview.html"
    },
    "cpu": {
      "supported": true,
      "description": "中央处理器（CPU），兼容性最好的回退方案",
      "driver_required": "None",
      "setup_guide": null
    }
  },
  "model_configuration": {
    "asr": {
      "model_name": "SenseVoiceSmall",
      "model_source": "iic/SenseVoiceSmall",
      "framework": "openvino",
      "format": "IR",
      "device_preference": ["NPU", "GPU", "CPU"],
      "model_path": "~/.cache/modelscope/LocalPrivacyScribe/sensevoice_openvino.xml",
      "languages": ["zh", "en", "ja", "ko", "yue", "sh"],
      "sample_rate": 16000
    },
    "ocr": {
      "model_name": "RapidOCR",
      "model_source": "rapidocr",
      "framework": "openvino",
      "format": "IR",
      "device_preference": ["NPU", "GPU", "CPU"],
      "model_path": "~/.cache/modelscope/LocalPrivacyScribe/rapidocr/",
      "model_files": ["det.xml", "det.bin", "rec.xml", "rec.bin"],
      "languages": ["zh", "en", "ja", "ko", "fr", "de", "ru"],
      "input_size": [640, 640]
    }
  },
  "examples": [
    {
      "title": "基础使用示例",
      "description": "使用默认配置（CPU）处理会议录音和白板截图",
      "code": "from local_privacy_scribe import LocalPrivacyScribeSkill\n\n# 初始化 Skill\nskill = LocalPrivacyScribeSkill()\n\n# 执行处理\nresult = skill._local_call(\n    audio_path=\"./meeting.wav\",\n    image_path=\"./whiteboard.png\"\n)\n\n# 查看结果\nif result['status'] == 'success':\n    print(f\"音频文本: {result['audio_text'][:100]}...\")\n    print(f\"图片文本: {result['image_text'][:100]}...\")\n    print(f\"输出目录: {result['metadata']['output_directory']}\")"
    },
    {
      "title": "NPU 加速示例",
      "description": "使用 Intel NPU 加速 ASR 和 OCR 推理",
      "code": "from local_privacy_scribe import LocalPrivacyScribeSkill\n\n# 使用 NPU 加速（推荐）\nskill = LocalPrivacyScribeSkill(\n    asr_device=\"NPU\",\n    ocr_device=\"NPU\",\n    output_dir=\"./output_npu\"\n)\n\nresult = skill._local_call(\n    audio_path=\"./meeting.wav\",\n    image_path=\"./whiteboard.png\",\n    meeting_title=\"Q4 产品规划会议\",\n    participants=[\"张三\", \"李四\", \"王五\"]\n)"
    },
    {
      "title": "GPU 加速示例",
      "description": "使用 GPU 加速以获得最佳性能",
      "code": "from local_privacy_scribe import LocalPrivacyScribeSkill\n\n# 使用 GPU 加速（性能最强）\nskill = LocalPrivacyScribeSkill(\n    asr_device=\"GPU\",\n    ocr_device=\"GPU\",\n    asr_config={\n        \"PERFORMANCE_HINT\": \"LATENCY\",\n        \"NUM_STREAMS\": \"1\"\n    },\n    ocr_config={\n        \"PERFORMANCE_HINT\": \"THROUGHPUT\",\n        \"NUM_STREAMS\": \"4\"\n    }\n)\n\nresult = skill._local_call(\n    audio_path=\"./long_meeting.wav\",\n    image_path=\"./whiteboard.png\"\n)"
    },
    {
      "title": "自定义输出示例",
      "description": "自定义输出目录和模板",
      "code": "from local_privacy_scribe import LocalPrivacyScribeSkill\n\nskill = LocalPrivacyScribeSkill(\n    output_dir=\"./custom_output\",\n    auto_generate_ics=True,\n    auto_generate_markdown=True\n)\n\nresult = skill._local_call(\n    audio_path=\"./meeting.wav\",\n    image_path=\"./whiteboard.png\",\n    template=\"detailed\",\n    language=\"zh\"\n)\n\n# 访问生成的文件\nics_path = result['output_files']['ics']\nmd_path = result['output_files']['markdown']\njson_path = result['output_files']['json']"
    }
  ],
  "error_handling": {
    "file_not_found": {
      "error_code": "FILE_NOT_FOUND",
      "http_status": 404,
      "user_message": "指定的音频或图片文件不存在，请检查文件路径是否正确。",
      "technical_message": "FileNotFoundError: 文件路径不存在或无法访问"
    },
    "invalid_format": {
      "error_code": "INVALID_FORMAT",
      "http_status": 400,
      "user_message": "文件格式不支持，请使用 .wav 格式的音频文件和 .png/.jpg 格式的图片文件。",
      "technical_message": "ValueError: 不支持的文件格式"
    },
    "inference_error": {
      "error_code": "INFERENCE_ERROR",
      "http_status": 500,
      "user_message": "模型推理过程出错，请检查 OpenVINO 环境配置和设备可用性。",
      "technical_message": "RuntimeError: ASR/OCR 推理失败"
    },
    "model_load_error": {
      "error_code": "MODEL_LOAD_ERROR",
      "http_status": 500,
      "user_message": "模型文件加载失败，请确保已下载并转换 OpenVINO IR 格式的模型文件。",
      "technical_message": "RuntimeError: 模型文件缺失或损坏"
    }
  },
